# numenews — local environment template.
#
# Copy to `.env` (`cp .env.example .env`); `.env` is gitignored, only this template is
# committed. Every value has a working default, because the demo path needs no API keys
# (see AGENTS.md). Blank values are ignored rather than read as empty strings.

# --- Runtime -------------------------------------------------------------------
# `dev` renders human-readable logs, `prod` one JSON object per line (stderr either way).
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Qdrant --------------------------------------------------------------------
# Matches docker-compose.yml. The local container has no auth, so the key stays blank.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- LLM -----------------------------------------------------------------------
# Any OpenAI-compatible endpoint: OpenRouter, a local Ollama
# (http://localhost:11434/v1) or api.openai.com. A blank `OPENAI_BASE_URL` means the
# provider default.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# --- Cache ---------------------------------------------------------------------
# hishel (RFC 9111) cache directory for news HTTP responses.
CACHE_DIR=.cache/hishel

# --- News APIs (phase 2) -------------------------------------------------------
# All five are optional and blank values are ignored: a source without its key is not
# queried at all, so a half-configured machine still gets the feeds that are available
# and the default demo path (GDELT, which needs no key) works with none of them.
# Limits and request shapes: docs/NEWS_SOURCES.md.
NEWSAPI_KEY=
GNEWS_KEY=
MEDIASTACK_KEY=
CURRENTS_KEY=
